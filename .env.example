# Shopify Storefront API — get these from your store admin:
# Settings → Apps and sales channels → Develop apps → (create app) → API credentials
# STORE_DOMAIN is the technical myshopify.com endpoint used to call the Storefront GraphQL API.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=12ujgr-dk.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Customer-facing Shopify domain (checkout, /account). Set this to the primary
# custom domain you configured in Shopify Admin → Settings → Domains
# (e.g. pay.petbale.com). If empty, /track falls back to STORE_DOMAIN above.
NEXT_PUBLIC_SHOPIFY_CUSTOMER_DOMAIN=pay.petbale.com

# Ali Reviews / Kudosi public API — get from app menu Integration → API key
# Base URL: https://pub.kudosi.ai/public
ALI_REVIEWS_API_KEY=

# Public site origin used by metadataBase, sitemap, robots, OG tags.
# Local dev: http://localhost:3000 (default fallback). Production: https://petbale.com
NEXT_PUBLIC_SITE_URL=https://petbale.com

# ── Contact form (Resend) ──────────────────────────────────────────────
# Get API key at https://resend.com after verifying domain DNS (SPF + DKIM).
# 1. Sign up at resend.com
# 2. Add domain petbale.com → copy the DNS records into your registrar
# 3. Wait for "Verified" status → create API key
# 4. Set RESEND_API_KEY here
# CONTACT_FROM_EMAIL must use the verified domain (e.g. noreply@petbale.com).
# CONTACT_TO_EMAIL is the inbox where contact submissions land.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@petbale.com
CONTACT_TO_EMAIL=cs@petbale.com

# ── Analytics (optional — scripts only load when set) ──────────────────
# GA4: Admin → Data Streams → Web → Measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Meta Pixel: Events Manager → Data Sources → Pixel ID (numeric, ~15 digits)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads tag: Google Ads → Tools → Google tag → ID (AW-XXXXXXXXX). Powers
# the storefront base/remarketing tag + view_item / add_to_cart / begin_checkout.
# The real Purchase conversion fires on Shopify checkout via a Custom Pixel.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Optional second Google Ads account (AW-XXXXXXXXX). Configured on the same gtag
# instance — storefront events broadcast to BOTH accounts. Its Purchase
# conversion must also be added to the Shopify Custom Pixel separately.
NEXT_PUBLIC_GOOGLE_ADS_ID_2=
