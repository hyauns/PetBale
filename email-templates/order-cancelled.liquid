{% capture email_title %}Your order has been cancelled{% endcapture %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ email_title }}</title>
</head>
<body style="margin:0;padding:0;background-color:#FAF6F0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;color:#000000;">

<div style="display:none;max-height:0;overflow:hidden;">
  Order {{ order_name }} has been cancelled. Refund details inside.
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#FAF6F0;padding:24px 12px;">
  <tr>
    <td align="center">

      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;">

        <!-- Brand bar -->
        <tr>
          <td align="center" style="padding:0 0 16px 0;">
            <a href="https://petbale.com" style="text-decoration:none;color:#000000;">
              <span style="font-family:Georgia,'Times New Roman',serif;font-size:32px;font-weight:900;letter-spacing:-1px;color:#000000;">PETBALE</span>
            </a>
            <div style="font-size:10px;font-weight:800;letter-spacing:3px;color:#525252;margin-top:4px;text-transform:uppercase;">Premium pet care · US-based</div>
          </td>
        </tr>

        <!-- Status bar -->
        <tr>
          <td style="background-color:#000000;border:2px solid #000000;border-radius:9999px;padding:12px 24px;text-align:center;">
            <span style="font-size:12px;font-weight:900;letter-spacing:2px;text-transform:uppercase;color:#FFFFFF;">✕ Order Cancelled · {{ order_name }}</span>
          </td>
        </tr>

        <tr><td style="height:16px;line-height:16px;">&nbsp;</td></tr>

        <!-- Main card -->
        <tr>
          <td style="background-color:#FFFFFF;border:2px solid #000000;border-radius:16px;padding:32px 28px;box-shadow:4px 4px 0 #000000;">

            <h1 style="margin:0 0 8px 0;font-size:28px;font-weight:900;line-height:1.1;color:#000000;text-transform:uppercase;letter-spacing:-0.5px;">
              Order cancelled
            </h1>
            <p style="margin:0 0 16px 0;font-size:15px;line-height:1.5;color:#525252;">
              Hi {{ customer.first_name | default: 'friend' }} — your order {{ order_name }} has been cancelled and we've started the refund. Sorry it didn't work out this time.
            </p>

            {% if cancel_reason %}
            <div style="background-color:#FAF6F0;border:1px solid #00000020;border-radius:12px;padding:14px 18px;margin-bottom:24px;">
              <div style="font-size:11px;font-weight:900;letter-spacing:2px;text-transform:uppercase;color:#525252;margin-bottom:4px;">Cancellation reason</div>
              <div style="font-size:14px;font-weight:700;color:#000000;">{{ cancel_reason_label | default: cancel_reason }}</div>
            </div>
            {% endif %}

            <!-- Refund info -->
            <div style="background-color:#ffea79;border:2px solid #000000;border-radius:12px;padding:18px 20px;margin-bottom:24px;">
              <div style="font-size:11px;font-weight:900;letter-spacing:2px;text-transform:uppercase;color:#000000;margin-bottom:6px;">💰 Refund</div>
              <div style="font-size:22px;font-weight:900;color:#000000;margin-bottom:6px;">{{ total_price | money }}</div>
              <div style="font-size:13px;line-height:1.5;color:#000000;">
                The refund is processing to your original payment method. Expect it within <strong>5–10 business days</strong> depending on your bank.
              </div>
            </div>

            <!-- Cancelled items -->
            <div style="border-top:2px solid #000000;padding-top:20px;">
              <div style="font-size:11px;font-weight:900;letter-spacing:2.5px;text-transform:uppercase;color:#525252;margin-bottom:14px;">
                Cancelled Items
              </div>

              {% for line in line_items %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;">
                <tr>
                  <td valign="top" width="72" style="padding-right:14px;">
                    {% if line.image %}
                    <img src="{{ line | img_url: 'compact' }}" alt="{{ line.title | escape }}" width="64" height="64" style="display:block;width:64px;height:64px;border:1px solid #00000020;border-radius:8px;object-fit:cover;background:#FAF6F0;opacity:0.7;">
                    {% endif %}
                  </td>
                  <td valign="top" style="font-size:14px;line-height:1.4;">
                    <div style="font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:0.5px;">{{ line.title }}</div>
                    {% if line.variant.title and line.variant.title != 'Default Title' %}
                    <div style="font-size:12px;color:#525252;margin-top:2px;">{{ line.variant.title }}</div>
                    {% endif %}
                    <div style="font-size:12px;color:#525252;margin-top:4px;">Qty {{ line.quantity }} · {{ line.line_price | money }}</div>
                  </td>
                </tr>
              </table>
              {% endfor %}
            </div>

            <!-- Reorder CTA -->
            <div style="margin-top:24px;padding-top:20px;border-top:2px solid #000000;text-align:center;">
              <p style="margin:0 0 16px 0;font-size:14px;line-height:1.5;color:#525252;">
                Changed your mind? We're still here. Try us again — same products, same fast shipping.
              </p>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                <tr>
                  <td style="background-color:#ffea79;border:2px solid #000000;border-radius:9999px;padding:0;">
                    <a href="https://petbale.com/shop" style="display:inline-block;padding:14px 32px;color:#000000;font-size:13px;font-weight:900;letter-spacing:2px;text-transform:uppercase;text-decoration:none;">
                      Shop Again →
                    </a>
                  </td>
                </tr>
              </table>
            </div>

          </td>
        </tr>

        <tr><td style="height:16px;line-height:16px;">&nbsp;</td></tr>

        <!-- Support callout -->
        <tr>
          <td style="background-color:#FF69B4;border:2px solid #000000;border-radius:16px;padding:20px 24px;box-shadow:4px 4px 0 #000000;text-align:center;">
            <div style="font-size:18px;font-weight:900;color:#000000;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">
              Questions? 🐾
            </div>
            <div style="font-size:13px;line-height:1.5;color:#000000;">
              Write to
              <a href="mailto:cs@petbale.com" style="color:#000000;font-weight:900;text-decoration:underline;">cs@petbale.com</a>
              or reply to this email — we want to make it right.
            </div>
          </td>
        </tr>

        <tr><td style="height:24px;line-height:24px;">&nbsp;</td></tr>

        <!-- Footer NAP -->
        <tr>
          <td style="text-align:center;font-size:11px;line-height:1.6;color:#525252;padding:0 16px;">
            <div style="font-weight:800;color:#000000;letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;">PetBale</div>
            <div>Operated by DOG BOWL BAKERY LLC</div>
            <div>3832 FESCUE ST, CLERMONT FL 34714, USA</div>
            <div>+1 (239) 441-1004 · <a href="mailto:cs@petbale.com" style="color:#525252;text-decoration:underline;">cs@petbale.com</a></div>
            <div style="margin-top:12px;">
              <a href="https://petbale.com" style="color:#525252;text-decoration:underline;">petbale.com</a>
              ·
              <a href="https://petbale.com/refund-policy" style="color:#525252;text-decoration:underline;">Refund Policy</a>
              ·
              <a href="{{ shop.url }}/unsubscribe" style="color:#525252;text-decoration:underline;">Unsubscribe</a>
            </div>
            <div style="margin-top:10px;color:#9ca3af;">© {{ 'now' | date: '%Y' }} PetBale. All rights reserved.</div>
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
